{
  "name": "@tokenforge/extension",
  "displayName": "TokenForge Context Guard",
  "description": "Score and recommend filtering inactive / high-risk editor tabs to cut token bleed.",
  "publisher": "tokenforge",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@tokenforge/risk-core": "*"
  },
  "activationEvents": [ "onStartupFinished" ],
  "contributes": {
    "commands": [
      {
        "command": "tokenforge.hello",
        "title": "Hello",
        "category": "TokenForge"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2"
  }
}
