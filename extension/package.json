{
  "name": "tokenforge-context-guard",
  "displayName": "TokenForge — AI Context Guard",
  "description": "Cut token bleed from open tabs and AI rules. Shield costly context, analyze instructions, and track savings — works with Cursor, Copilot, and other agents.",
  "publisher": "tokenforge",
  "icon": "media/tokenforge-icon.png",
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/JordyNicholas/TokenForge.git"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "npm run build",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@tokenforge/context-adapters": "*",
    "@tokenforge/enrichers": "*",
    "@tokenforge/policy-adapters": "*",
    "@tokenforge/risk-core": "*"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "tokenforge-shield": {
        "description": "TokenForge shield",
        "default": {
          "fontPath": "media/tokenforge-icons.woff",
          "fontCharacter": "\\E900"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenforge",
          "title": "TokenForge",
          "icon": "media/tokenforge.svg"
        }
      ]
    },
    "views": {
      "tokenforge": [
        {
          "id": "tokenforge.riskPanel",
          "name": "Open tabs",
          "when": "tokenforge.workspaceEligible"
        },
        {
          "id": "tokenforge.riskPulse",
          "name": "Overview",
          "type": "webview",
          "when": "tokenforge.workspaceEligible"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "tokenforge.welcome",
        "title": "TokenForge Context Guard",
        "description": "Cut AI context bleed from open editor tabs with Shield, Allow, and live context cost.",
        "steps": [
          {
            "id": "tokenforge.step.overview",
            "title": "Open Overview",
            "description": "See live **context cost**, session savings, and quick Shield actions in the Overview panel.\n[Open Overview](command:tokenforge.focusOverview)",
            "media": {
              "markdown": "media/walkthrough/overview.md"
            },
            "completionEvents": [
              "onView:tokenforge.riskPulse"
            ]
          },
          {
            "id": "tokenforge.step.openTabs",
            "title": "Review open tabs",
            "description": "Use **Open tabs** to Allow or Shield noisy files. Shield applies provider-native levers where available.\n[Open tabs](command:tokenforge.focusRiskPanel)",
            "media": {
              "markdown": "media/walkthrough/open-tabs.md"
            },
            "completionEvents": [
              "onCommand:tokenforge.shieldTab"
            ]
          },
          {
            "id": "tokenforge.step.autoShield",
            "title": "Auto-shield lockfiles",
            "description": "Enable **Auto-shield lockfiles** to Shield pending lockfile and generated tabs automatically.\n[Enable Auto-shield](command:tokenforge.enableAutoFilterHighRisk)",
            "media": {
              "markdown": "media/walkthrough/auto-shield.md"
            },
            "completionEvents": [
              "onCommand:tokenforge.enableAutoFilterHighRisk"
            ]
          },
          {
            "id": "tokenforge.step.compact",
            "title": "Compact rules",
            "description": "Preview a lean instruction section from your scan before a long agent turn.\n[Compact rules preview](command:tokenforge.compactRulesPreview)",
            "media": {
              "markdown": "media/walkthrough/compact-rules.md"
            },
            "completionEvents": [
              "onCommand:tokenforge.compactRulesPreview"
            ]
          },
          {
            "id": "tokenforge.step.prove",
            "title": "Export Prove handoff",
            "description": "Export **session-stats.json** and open the Prove dashboard with live hygiene.\n[Send hygiene to dashboard](command:tokenforge.sendHygieneToDashboard)",
            "media": {
              "markdown": "media/walkthrough/prove-handoff.md"
            },
            "completionEvents": [
              "onCommand:tokenforge.sendHygieneToDashboard"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "tokenforge.keepTab",
        "title": "Allow",
        "category": "TokenForge",
        "icon": "$(pinned)"
      },
      {
        "command": "tokenforge.filterTab",
        "title": "Shield",
        "category": "TokenForge",
        "icon": "$(shield)"
      },
      {
        "command": "tokenforge.shieldTab",
        "title": "Shield tab",
        "category": "TokenForge",
        "icon": "$(shield)"
      },
      {
        "command": "tokenforge.restoreTab",
        "title": "Unshield",
        "category": "TokenForge",
        "icon": "$(discard)"
      },
      {
        "command": "tokenforge.shieldAllPending",
        "title": "Shield all pending",
        "category": "TokenForge",
        "icon": "$(shield)"
      },
      {
        "command": "tokenforge.cleanSession",
        "title": "Clean session",
        "category": "TokenForge",
        "icon": "$(clear-all)"
      },
      {
        "command": "tokenforge.prepareAgentSession",
        "title": "Prepare agent session",
        "category": "TokenForge",
        "icon": "$(rocket)"
      },
      {
        "command": "tokenforge.runDiscover",
        "title": "Run discover",
        "category": "TokenForge",
        "icon": "$(search)"
      },
      {
        "command": "tokenforge.copySmartExcerpt",
        "title": "Copy smart excerpt",
        "category": "TokenForge",
        "icon": "$(copy)"
      },
      {
        "command": "tokenforge.compactRulesPreview",
        "title": "Compact rules preview",
        "category": "TokenForge",
        "icon": "$(fold)"
      },
      {
        "command": "tokenforge.applyTaskContextPack",
        "title": "Apply task pack",
        "category": "TokenForge",
        "icon": "$(checklist)"
      },
      {
        "command": "tokenforge.exportLastScan",
        "title": "Export last-scan.json",
        "category": "TokenForge",
        "icon": "$(save)"
      },
      {
        "command": "tokenforge.revealLastScan",
        "title": "Reveal last-scan.json",
        "category": "TokenForge",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tokenforge.refreshRiskPanel",
        "title": "Refresh scores",
        "category": "TokenForge",
        "icon": "$(refresh)"
      },
      {
        "command": "tokenforge.clearFilters",
        "title": "Reset choices",
        "category": "TokenForge",
        "icon": "$(clear-all)"
      },
      {
        "command": "tokenforge.toggleAutoFilterHighRisk",
        "title": "Auto-shield lockfiles",
        "category": "TokenForge",
        "icon": "$(zap)"
      },
      {
        "command": "tokenforge.enableAutoFilterHighRisk",
        "title": "Enable auto-shield lockfiles",
        "category": "TokenForge",
        "icon": "$(zap)"
      },
      {
        "command": "tokenforge.disableAutoFilterHighRisk",
        "title": "Disable auto-shield lockfiles",
        "category": "TokenForge",
        "icon": "$(check)"
      },
      {
        "command": "tokenforge.focusRiskPanel",
        "title": "Focus Open tabs",
        "category": "TokenForge"
      },
      {
        "command": "tokenforge.focusOverview",
        "title": "Focus Overview",
        "category": "TokenForge"
      },
      {
        "command": "tokenforge.moreActions",
        "title": "All TokenForge actions…",
        "category": "TokenForge",
        "icon": "$(list-flat)"
      },
      {
        "command": "tokenforge.toggleDurableFilterDecisions",
        "title": "Toggle durable choices",
        "category": "TokenForge",
        "icon": "$(history)"
      },
      {
        "command": "tokenforge.toggleCloseTabOnHardShield",
        "title": "Toggle close tab on hard Shield",
        "category": "TokenForge",
        "icon": "$(close)"
      },
      {
        "command": "tokenforge.toggleNotifyOnIdle",
        "title": "Toggle notify on idle",
        "category": "TokenForge",
        "icon": "$(bell)"
      },
      {
        "command": "tokenforge.exportSessionStats",
        "title": "Export session-stats.json",
        "category": "TokenForge",
        "icon": "$(graph)"
      },
      {
        "command": "tokenforge.sessionNarrative",
        "title": "Session narrative (optional)",
        "category": "TokenForge",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "tokenforge.revealSessionStats",
        "title": "Reveal session-stats.json",
        "category": "TokenForge",
        "icon": "$(graph-line)"
      },
      {
        "command": "tokenforge.sendHygieneToDashboard",
        "title": "Send hygiene to dashboard",
        "category": "TokenForge",
        "icon": "$(link-external)"
      },
      {
        "command": "tokenforge.exportToInbox",
        "title": "Export to inbox",
        "category": "TokenForge",
        "icon": "$(inbox)"
      },
      {
        "command": "tokenforge.setTeamLabel",
        "title": "Set team label",
        "category": "TokenForge",
        "icon": "$(tag)"
      },
      {
        "command": "tokenforge.openHonorSmoke",
        "title": "Honor smoke checklist",
        "category": "TokenForge",
        "icon": "$(checklist)"
      },
      {
        "command": "tokenforge.enrichInstructions",
        "title": "Analyze rules",
        "category": "TokenForge",
        "icon": "$(sparkle)"
      },
      {
        "command": "tokenforge.toggleLlmEnrichment",
        "title": "Toggle AI enrichment",
        "category": "TokenForge",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tokenforge.enableAutoFilterHighRisk",
          "when": "(view == tokenforge.riskPanel || view == tokenforge.riskPulse) && !config.tokenforge.autoFilterHighRisk",
          "group": "navigation@0"
        },
        {
          "command": "tokenforge.disableAutoFilterHighRisk",
          "when": "(view == tokenforge.riskPanel || view == tokenforge.riskPulse) && config.tokenforge.autoFilterHighRisk",
          "group": "navigation@0"
        },
        {
          "command": "tokenforge.focusOverview",
          "when": "view == tokenforge.riskPanel",
          "group": "navigation@1"
        },
        {
          "command": "tokenforge.shieldAllPending",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "navigation@2"
        },
        {
          "command": "tokenforge.refreshRiskPanel",
          "when": "view == tokenforge.riskPanel",
          "group": "1_overflow@1"
        },
        {
          "command": "tokenforge.exportLastScan",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@2"
        },
        {
          "command": "tokenforge.revealLastScan",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@3"
        },
        {
          "command": "tokenforge.revealSessionStats",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@4"
        },
        {
          "command": "tokenforge.sendHygieneToDashboard",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@5"
        },
        {
          "command": "tokenforge.exportToInbox",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@6"
        },
        {
          "command": "tokenforge.setTeamLabel",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@7"
        },
        {
          "command": "tokenforge.openHonorSmoke",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@8"
        },
        {
          "command": "tokenforge.clearFilters",
          "when": "view == tokenforge.riskPanel",
          "group": "1_overflow@9"
        },
        {
          "command": "tokenforge.enrichInstructions",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@10"
        },
        {
          "command": "tokenforge.cleanSession",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@11"
        },
        {
          "command": "tokenforge.prepareAgentSession",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@12"
        },
        {
          "command": "tokenforge.runDiscover",
          "when": "view == tokenforge.riskPanel || view == tokenforge.riskPulse",
          "group": "1_overflow@13"
        }
      ],
      "view/item/context": [
        {
          "command": "tokenforge.keepTab",
          "when": "view == tokenforge.riskPanel && viewItem == tokenforge.atRiskTab",
          "group": "inline@1"
        },
        {
          "command": "tokenforge.shieldTab",
          "when": "view == tokenforge.riskPanel && viewItem =~ /tokenforge\\.(atRisk|kept)Tab/",
          "group": "inline@2"
        },
        {
          "command": "tokenforge.restoreTab",
          "when": "view == tokenforge.riskPanel && viewItem == tokenforge.filteredTab",
          "group": "inline@1"
        },
        {
          "command": "tokenforge.keepTab",
          "when": "view == tokenforge.riskPanel && viewItem == tokenforge.atRiskTab",
          "group": "1_actions"
        },
        {
          "command": "tokenforge.shieldTab",
          "when": "view == tokenforge.riskPanel && viewItem =~ /tokenforge\\.(atRisk|kept)Tab/",
          "group": "1_actions"
        },
        {
          "command": "tokenforge.restoreTab",
          "when": "view == tokenforge.riskPanel && viewItem == tokenforge.filteredTab",
          "group": "1_actions"
        }
      ]
    },
    "configuration": {
      "title": "TokenForge",
      "properties": {
        "tokenforge.contextProvider": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "cursor",
            "copilot",
            "claude",
            "gemini",
            "generic"
          ],
          "markdownDescription": "Which **context adapter** applies Shield levers. `auto` detects Cursor / Copilot / Gemini / Claude from workspace hints and installed extensions."
        },
        "tokenforge.closeTabOnHardShield": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When enabled, **Hard Shield** closes the editor tab after applying provider-native levers."
        },
        "tokenforge.idleMinutesFocused": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "markdownDescription": "Minutes of inactivity before a **focused** tab is scored as idle context cost."
        },
        "tokenforge.idleMinutesBackground": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "Minutes of inactivity before a **background** tab is scored as idle context cost."
        },
        "tokenforge.notifyOnIdle": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show a notification when tabs cross idle thresholds (estimate hygiene nudge only)."
        },
        "tokenforge.prePromptGate": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Before agent turns, warn when **context cost** exceeds the rules budget threshold."
        },
        "tokenforge.discoverIntervalHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "markdownDescription": "Hours to look back when **Run discover** ranks recently changed workspace files."
        },
        "tokenforge.rulesBudgetThreshold": {
          "type": "number",
          "default": 8000,
          "minimum": 0,
          "markdownDescription": "Token estimate threshold for rules / context budget warnings in Overview and pre-prompt gate."
        },
        "tokenforge.showWelcome": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the TokenForge walkthrough on first eligible workspace open."
        },
        "tokenforge.continuousAnalyze": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Debounced **Analyze rules** on save (opt-in; may call configured LLM enricher)."
        },
        "tokenforge.installCursorHooks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Install project-level **Cursor hooks** (`.cursor/hooks.json`) for Shield read deny and optional post-turn path logging. Opt-in; modifies workspace files."
        },
        "tokenforge.postTurnLogging": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When Cursor hooks are installed, append agent read paths to `.tokenforge/post-turn-paths.jsonl` on each turn (observe-only)."
        },
        "tokenforge.autoFilterHighRisk": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Workspace-only **Auto-shield lockfiles**. When enabled, pending lockfile and generated tabs Shield automatically. User/global values are ignored."
        },
        "tokenforge.durableFilterDecisions": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Workspace-only **durable choices**. Allow/Shield decisions persist in `.tokenforge/` until Unshield or Reset choices."
        },
        "tokenforge.workspaceMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "git-only",
            "manifest-only"
          ],
          "description": "When TokenForge activates for a folder workspace. auto: git repo or root project manifest (package.json, pom.xml, go.mod, …). always: any folder. git-only / manifest-only: stricter subsets."
        },
        "tokenforge.team": {
          "type": "string",
          "default": "default",
          "description": "Team label written into .tokenforge/last-scan.json."
        },
        "tokenforge.repo": {
          "type": "string",
          "default": "",
          "description": "Optional repo label for last-scan.json. Defaults to the workspace folder name."
        },
        "tokenforge.provider": {
          "type": "string",
          "default": "generic",
          "enum": [
            "copilot",
            "cursor",
            "claude",
            "gemini",
            "generic"
          ],
          "description": "Fix adapter id recorded in last-scan.json (scoring ignores this)."
        },
        "tokenforge.llmEnrichment": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Opt-in. When enabled, TokenForge: Analyze rules may call an LLM enricher. Live Context Guard scoring stays heuristic."
        },
        "tokenforge.llm": {
          "type": "string",
          "default": "noop",
          "description": "LLM backend spec (same as CLI --llm): noop (default), ollama:<model>, anthropic:<model>, codex, or claude-code. The two CLI backends take no model — they use whatever that CLI is signed in with."
        },
        "tokenforge.llmEndpoint": {
          "type": "string",
          "default": "",
          "description": "Optional override for Ollama/Anthropic endpoint. Empty uses backend defaults."
        },
        "tokenforge.llmTimeout": {
          "type": "number",
          "default": 600,
          "description": "Per-batch enricher timeout in seconds. Default 600 survives a small local Ollama model on CPU; raise toward 900+ for larger models (e.g. qwen2.5-coder:7b) on CPU-only hosts."
        },
        "tokenforge.allowExternalLlm": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Allow external enrichers (anthropic, codex, claude-code, cursor-cli, gemini-cli) to send bounded candidate excerpts off this machine — same honesty gate as CLI `--allow-external`. Only `noop` and `ollama` run locally without this flag."
        },
        "tokenforge.dashboardBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5173/board/combined",
          "scope": "resource",
          "description": "Prove dashboard base URL for Send hygiene to dashboard (?session= handoff)."
        },
        "tokenforge.inboxPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "EM inbox root. Export to inbox copies artifacts to {inboxPath}/{team}/{repo}/.tokenforge/."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.2",
    "vitest": "^3.2.4"
  }
}
