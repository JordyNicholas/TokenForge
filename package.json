{
  "name": "tokenforge",
  "private": true,
  "version": "0.0.0",
  "description": "Enterprise AI Coding FinOps — detect, fix, and prove token waste across coding agents.",
  "workspaces": [
    "packages/*",
    "cli",
    "dashboard",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:cli": "npm run build -w @tokenforge/cli",
    "build:vsc-e": "npm run build -w @tokenforge/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "tokenforge": "node ./cli/bin/tokenforge.mjs",
    "tokenforge:help": "node ./cli/bin/tokenforge.mjs help",
    "tokenforge:scan": "node ./cli/bin/tokenforge.mjs scan fixtures/noisy-app",
    "tokenforge:apply": "node ./cli/bin/tokenforge.mjs apply fixtures/noisy-app",
    "tokenforge:init": "node ./cli/bin/tokenforge.mjs init fixtures/noisy-app",
    "tokenforge:prove": "bash ./scripts/prove-scan.sh",
    "tokenforge:pilot": "bash ./scripts/pilot-pack.sh",
    "tokenforge:presentation-hybrid": "bash ./scripts/presentation-hybrid.sh",
    "tokenforge:presentation-heuristic": "bash ./scripts/presentation-heuristic.sh",
    "tokenforge:presentation-full": "bash ./scripts/presentation-full.sh",
    "tokenforge:reset-hybrid-eval": "rm -rf fixtures/hybrid-eval-app/.tokenforge && git checkout -- fixtures/hybrid-eval-app/.github/copilot-instructions.md",
    "tokenforge:generate-hybrid-eval-instructions": "node ./scripts/generate-hybrid-eval-instructions.mjs",
    "tokenforge:usage-sync": "bash ./scripts/prove-usage-sync.sh",
    "tokenforge:dashboard": "npm run dev -w @tokenforge/dashboard",
    "tokenforge:dashboard:build": "npm run build -w @tokenforge/dashboard",
    "tokenforge:dashboard:preview": "npm run preview -w @tokenforge/dashboard",
    "tokenforge:extension": "npm run build -w @tokenforge/extension",
    "tokenforge:extension:watch": "npm run watch -w @tokenforge/extension"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
