{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenforge.dev/schema/risk-event/v0",
  "title": "TokenForge Token Risk report (v0)",
  "description": "Shared Detect/Fix → Prove document written as .tokenforge/scan-report.json or last-scan.json. Scoring does not depend on provider. Optional hybrid-scan fields are backward-compatible extensions documented in docs/HYBRID_SCAN_DESIGN.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "timestamp",
    "repo",
    "team",
    "provider",
    "findings",
    "totals"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["extension", "cli"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": ["copilot", "cursor", "claude", "generic"],
      "description": "Fix adapter that produced or will produce policy files. Risk scoring ignores this."
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "totals": { "$ref": "#/$defs/totals" },
    "scan": { "$ref": "#/$defs/scan" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "bytes", "estTokens", "action"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason": {
          "type": "string",
          "enum": [
            "inactive_tab",
            "high_risk_filetype",
            "oversized",
            "semantic_bloat",
            "redundant_instructions",
            "low_signal_config"
          ]
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "estTokens": { "type": "integer", "minimum": 0 },
        "action": {
          "type": "string",
          "enum": ["filtered", "excluded", "kept"]
        },
        "source": {
          "type": "string",
          "enum": ["heuristic", "llm", "combined"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "detail": { "type": "string" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeTokens", "afterTokens", "savedTokens"],
      "properties": {
        "beforeTokens": { "type": "integer", "minimum": 0 },
        "afterTokens": { "type": "integer", "minimum": 0 },
        "savedTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["heuristic", "hybrid"]
        },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "model", "durationMs", "candidatesSent"],
          "properties": {
            "backend": {
              "type": "string",
              "enum": ["noop", "ollama", "openai", "anthropic"]
            },
            "model": { "type": "string", "minLength": 1 },
            "endpoint": { "type": "string" },
            "durationMs": { "type": "number", "minimum": 0 },
            "candidatesSent": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
