{
  "name": "tokenforge",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tokenforge",
      "version": "0.0.0",
      "workspaces": [
        "packages/*",
        "cli",
        "dashboard",
        "extension"
      ],
      "devDependencies": {
        "typescript": "^5.9.2"
      }
    },
    "cli": {
      "name": "@tokenforge/cli",
      "version": "0.0.0",
      "dependencies": {
        "@tokenforge/risk-core": "*"
      }
    },
    "dashboard": {
      "name": "@tokenforge/dashboard",
      "version": "0.0.0",
      "dependencies": {
        "@tokenforge/risk-core": "*"
      }
    },
    "extension": {
      "name": "@tokenforge/extension",
      "version": "0.0.0",
      "dependencies": {
        "@tokenforge/risk-core": "*"
      }
    },
    "node_modules/@tokenforge/cli": {
      "resolved": "cli",
      "link": true
    },
    "node_modules/@tokenforge/dashboard": {
      "resolved": "dashboard",
      "link": true
    },
    "node_modules/@tokenforge/extension": {
      "resolved": "extension",
      "link": true
    },
    "node_modules/@tokenforge/risk-core": {
      "resolved": "packages/risk-core",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/risk-core": {
      "name": "@tokenforge/risk-core",
      "version": "0.0.0"
    }
  }
}
