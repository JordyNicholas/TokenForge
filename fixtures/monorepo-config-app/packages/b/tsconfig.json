    "compilerOptions": {
        "skipLibCheck": true,
        "declaration": true,
        "outDir": "dist",
        "noUncheckedIndexedAccess": true,
        "moduleResolution": "Bundler",
        "strict": true,
        "module": "ESNext",
        "target": "ES2022"
    }
}
